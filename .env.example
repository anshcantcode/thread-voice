# Optional. The interruption lab runs without credentials or network inference.
# Live mode sends microphone audio and conversation text to Google and may incur charges.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Notes default to ~/.thread-voice/notes.sqlite3. Do not commit real notes.
# THREAD_DATA_DIR=/absolute/path/to/private/data
